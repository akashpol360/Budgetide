<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Budgetide" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#101513</item>
    </style>
    <style name="Theme.Budgetide.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101513</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Budgetide</item>
    </style>
</resources>